# PostgreSQL connection string (Coolify / Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vote_static?schema=public"

# HMAC-SHA256 secret for incoming mutation webhooks (X-Signature)
WEBHOOK_SECRET="replace-with-strong-32-char-webhook-secret"

# Admin dashboard login password & HMAC cookie signing secret
ADMIN_PASSWORD="replace-with-strong-admin-password"
AUTH_SECRET="replace-with-strong-32-char-auth-secret"

# Persistent directory for uploaded QRIS images, candidate photos, and payment proofs
UPLOAD_DIR="/app/uploads"

# Public base URL (optional, used for display/links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
